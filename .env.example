# Required server-side values are deliberately blank. Generate/configure locally only after approval.
OPENAI_API_KEY=
PEXELS_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
DEEPL_API_KEY=
JWT_SECRET_KEY=
# Optional explicit bootstrap; leave both blank to avoid creating an administrator.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
SERVER_HOST=127.0.0.1
ENABLE_ZAPIER_INTEGRATION=false
DAILY_VIDEO_LIMIT=2

# Optional trend-service credentials; leave unused services disabled.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Keep signup off; configure optional bootstrap credentials explicitly.
ALLOW_PUBLIC_SIGNUP=false
